{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Backend",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Vue Frontend",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": [
                "Flask Backend",
                "Vue Frontend"
            ]
        }
    ]
}