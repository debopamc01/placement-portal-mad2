{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Backend",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Vue Frontend",
            "type": "msedge",
            "request": "launch",
            "url": "http://127.0.0.1:5173",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": [
                "Flask Backend",
                "Vue Frontend"
            ],
            "preLaunchTask": "vite"
        }
    ]
}